    "destroy": "cdk destroy --all"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "aws-cdk": "^2.170.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2"
  }
}
