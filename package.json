{
  "name": "standin-infra",
  "version": "0.1.0",
  "private": true,
  "description": "Standin AWS 인프라 (CDK) — ECS Fargate + RDS + ALB + ECR + GitHub OIDC",
  "bin": {
    "standin-infra": "bin/standin.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
