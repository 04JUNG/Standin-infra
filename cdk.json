{
  "app": "npx ts-node --prefer-ts-exts bin/standin.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "**/*.d.ts", "**/*.js", "node_modules", "cdk.out"]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-ecs:disableExplicitDeploymentControllerForCircuitBreaker": true,
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": true,
    "@aws-cdk/core:target-partitions": ["aws"],
    "@aws-cdk/core:defaultCrossStackReferences": "strong",

    "//": "── 배포 설정. cdk deploy -c key=value 로 덮어쓸 수 있다. ──",
    "githubOrg": "04JUNG",
    "githubRepos": ["Standin-app-server", "Standin-server"],
    "githubOidcSubjectPrefixes": [
      "repo:04JUNG@302009989/Standin-app-server@1302376537",
      "repo:04JUNG/Standin-server"
    ],
    "//publicUrl": "CloudFront 공개 진입점. OAuth 리디렉트·이메일 인증 링크가 이 값을 쓴다.",
    "publicUrl": "https://d1bbz5oaj92efa.cloudfront.net",
    "//appEnv": "실제 배포된 값. development로 되돌리면 실서비스가 mock VLM·합성 라이브러리로 뒤집힌다.",
    "appEnv": "production",
    "//refineEnabled": "추론 서버의 refine 실행 스위치. 프로덕션에서 켜져 있다.",
    "refineEnabled": true,
    "//refineFeatureEnabled": "BFF의 사용자 노출 스위치. refineEnabled=true일 때만 true 허용. 프로덕션에서 켜져 있다.",
    "refineFeatureEnabled": true,
    "jobExecutionMode": "inline"
  }
}
